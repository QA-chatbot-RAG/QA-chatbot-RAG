[Unit]
Description=RAG QA embedding API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/RAG_01/model_api
EnvironmentFile=/home/ubuntu/RAG_01/.env
ExecStart=/home/ubuntu/RAG_01/model_api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
