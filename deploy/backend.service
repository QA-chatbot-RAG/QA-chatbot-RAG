[Unit]
Description=RAG QA FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/RAG_01/backend
EnvironmentFile=/home/ubuntu/RAG_01/.env
ExecStart=/home/ubuntu/RAG_01/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
